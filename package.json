{
  "name": "crypto-fighter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "verify-match": "node tools/verify-match.mjs",
    "test:contract": "bash hh/run-tests.sh",
    "test:input-mask": "node --import ./tools/register-types.mjs --test test/input-mask-v1.test.mjs",
    "test": "node --import ./tools/register-types.mjs --test test/*.test.mjs",
    "simulate-arena": "node tools/simulate-arena.mjs",
    "make-transcript": "node tools/make-transcript.mjs",
    "test:browser": "playwright test",
    "check": "npm run lint && npm test && npm run build && npm run test:contract && npm run test:browser",
    "commit-trace": "node tools/commit-trace.mjs",
    "verify-trace": "node tools/verify-trace.mjs",
    "evidence-trace": "node tools/evidence-trace.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@noble/secp256k1": "^2.3.0",
    "ethers": "^6.13.0",
    "lucide-react": "^0.577.0",
    "peerjs": "^1.5.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "hardhat": "^2.28.6",
    "peer": "1.0.2",
    "solc": "0.8.26",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
